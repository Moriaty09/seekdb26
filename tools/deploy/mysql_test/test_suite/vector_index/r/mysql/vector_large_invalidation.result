drop database if exists vector_large_invalidation;
create database vector_large_invalidation;
use vector_large_invalidation;
set @saved_lob_threshold=@@ob_default_lob_inrow_threshold;
set ob_default_lob_inrow_threshold=1024;
set @ones=concat('[',repeat('1,',2047),'1]');
set @twos=concat('[',repeat('2,',2047),'2]');
set @threes=concat('[',repeat('3,',2047),'3]');
create table docs(id int primary key, emb vector(2048));
insert into docs values(1,@ones),(2,@twos);
create vector index vi on docs(emb) with(distance=l2,type=hnsw,lib=vsag,m=10,ef_construction=12,ef_search=40);
start transaction;
update docs set emb=null where id=1;
select count(*)=1 and sum(id=2)=1 as invalidated_large_vector_absent
from (select id from docs order by l2_distance(emb,@ones) approximate limit 10) ann;
invalidated_large_vector_absent
1
rollback;
select count(*)=1 and sum(id=1)=1 as rollback_large_vector_restored
from (select id from docs order by l2_distance(emb,@ones) approximate limit 1) ann;
rollback_large_vector_restored
1
update docs set emb=null where id=1;
update docs set emb=@threes where id=1;
select count(*)=1 and sum(id=1)=1 as refilled_large_vector_visible
from (select id from docs order by l2_distance(emb,@threes) approximate limit 1) ann;
refilled_large_vector_visible
1
update docs set emb=@ones where id=1;
select count(*)=1 and sum(id=1)=1 as replaced_large_vector_visible
from (select id from docs order by l2_distance(emb,@ones) approximate limit 1) ann;
replaced_large_vector_visible
1
start transaction;
delete from docs where id=1;
rollback;
select count(*)=2 as rollback_delete_restored
from (select id from docs order by l2_distance(emb,@ones) approximate limit 10) ann;
rollback_delete_restored
1
delete from docs where id=1;
select count(*)=1 and sum(id=2)=1 as deleted_large_vector_absent
from (select id from docs order by l2_distance(emb,@ones) approximate limit 10) ann;
deleted_large_vector_absent
1
drop database vector_large_invalidation;
set ob_default_lob_inrow_threshold=@saved_lob_threshold;
