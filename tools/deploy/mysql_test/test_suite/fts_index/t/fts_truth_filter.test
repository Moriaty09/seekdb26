--enable_query_log
select count(*), sum(id) from docs where match(body) against('alpha beta');
select count(*), sum(id) from docs where match(body) against('alpha beta') > 0;
select count(*), sum(id) from docs where match(body) against('alpha beta') > 0.5;
select count(*), sum(id) from docs where match(body) against('alpha beta') is true;
select count(*), sum(id) from docs where not match(body) against('alpha beta');
select count(*), sum(id) from docs where match(body) against('absent');
select count(*), sum(id) from docs where match(body) against('alpha beta') and id between 250 and 780;
select count(*), sum(id) from docs force index(primary) where match(body) against('alpha beta');
select count(*), round(sum(score), 8), sum(score <> 0) from (select match(body) against('alpha beta') as score from docs where match(body) against('alpha beta')) t;
select count(*), sum(truth_value), sum(id) from (select id, (match(body) against('alpha beta') is true) as truth_value from docs where match(body) against('alpha beta')) t;
select id from docs where match(body) against('alpha beta') order by id limit 5 offset 255;
select count(*) from (select id from docs where match(body) against('alpha beta') limit 13 offset 257) t;
select count(*) from (select id from docs where match(body) against('alpha beta') limit 20 offset 600) t;
select count(*), sum(id) from docs where match(body) against('+alpha -beta' in boolean mode);
select count(*), sum(id) from docs where match(body) against('+beta -alpha' in boolean mode);
select count(*), sum(id) from docs where match(body) against('+alpha beta' in boolean mode);
select count(*), round(sum(score), 8), sum(score <> 0) from (select match(body) against('+alpha beta' in boolean mode) as score from docs where match(body) against('+alpha beta' in boolean mode)) t;
prepare p from 'select count(*), sum(id) from docs where match(body) against(?)';
set @q='alpha beta';
execute p using @q;
set @q='absent';
execute p using @q;
set @q='gamma';
execute p using @q;
set @q='alpha beta';
execute p using @q;
deallocate prepare p;
begin;
update docs set body='absent' where id <= 300;
select count(*), sum(id) from docs where match(body) against('alpha beta');
rollback;
select count(*), sum(id) from docs where match(body) against('alpha beta');
drop database fts_truth_filter;
