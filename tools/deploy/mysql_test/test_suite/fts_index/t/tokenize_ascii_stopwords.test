# Golden output comes from the baseline binary, including collation fallbacks.
select tokenize('a about an are as at be by com de en for from how i in is it la of on or that the this to was what when where who will with und the www', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('A ABOUT An ARE As AT Be BY Com DE En FOR From HOW I IN Is IT La OF On OR That THE This TO Was WHAT When WHERE Who WILL With UND The WWW', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('aa abouts ana area asa ata bee bya coma dea ena fora froma howa ii ina isa ita laa ofa ona ora thata thee thisa toa wasa whata whena wherea whoa willa witha unda wwwa', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('theory these therefore whereupon wherever aboutface withhold within winter uppercase LOWERCASE database performance indexing token token', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(_utf8mb4'the THE thé THÉ wíth WÍTH fróm Fróm wàs ÀBOUT ｔｈｅ café 中文' collate utf8mb4_general_ci, 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(_utf8mb4'the THE thé THÉ wíth WÍTH fróm Fróm wàs ÀBOUT ｔｈｅ café 中文' collate utf8mb4_bin, 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(_utf8mb4'the THE thé THÉ wíth WÍTH fróm Fróm wàs ÀBOUT ｔｈｅ café 中文' collate utf8mb4_unicode_ci, 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(cast('the THE with WITH DATABASE' as binary), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('the.the the-the the0 the_ the_fox about-face www.com notstop x y z', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(concat('the',char(0),'x the',char(0),' WITH',char(0),'in'), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize(concat(repeat('a',7),' ',repeat('a',8),' ',repeat('b',84),' ',repeat('b',85)), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('THE the a about thé café THE', 'space', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('THE the a about thé café THE', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('THE the a about thé café THE', 'ik', '[{"output":"all"}]') as tokens;
select tokenize('THE the a about thé café THE', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') as tokens;
select tokenize('', 'beng', '[{"output":"all"}]') as tokens;
select tokenize(NULL, 'beng', '[{"output":"all"}]') as tokens;
--disable_warnings
drop database if exists fts_ascii_stopwords;
--enable_warnings
create database fts_ascii_stopwords;
use fts_ascii_stopwords;
create table docs(id int primary key, body text,
  fulltext index ft(body) with parser beng parser_properties=(min_token_size=1));
insert into docs values (1,'the THE theory about database'),
  (2,'thé withhold wíth performance'),(3,'www.com data indexing'),(4,'THE about with');
select id from docs where match(body) against('the') order by id;
select id from docs where match(body) against('theory') order by id;
select id from docs where match(body) against('withhold database') order by id;
select id, round(match(body) against('theory database performance'),7) as score
  from docs where match(body) against('theory database performance') order by id;
begin;
update docs set body='the theory performance' where id=4;
select id from docs where match(body) against('theory performance') order by id;
rollback;
select id from docs where match(body) against('theory performance') order by id;
drop database fts_ascii_stopwords;
