# Collector state must reset between documents and prepared executions.
--disable_warnings
drop database if exists fts_collector_state;
--enable_warnings
create database fts_collector_state;
use fts_collector_state;
create table docs(id int primary key, body text, fulltext index ft(body) with parser beng);
insert into docs values (1,'alpha'),(2,'alpha beta'),(3,'alpha beta gamma'),
 (4,'gamma gamma'),(5,'delta alpha alpha'),(6,'beta delta'),(7,'unrelated'),(8,NULL);
select id, round(match(body) against('alpha'), 9) as score from docs where match(body) against('alpha') order by id;
select id, round(match(body) against('alpha beta'), 9) as score from docs where match(body) against('alpha beta') order by id;
select id, round(match(body) against('alpha beta gamma'), 9) as score from docs where match(body) against('alpha beta gamma') order by id;
select id, round(match(body) against('alpha beta gamma delta'), 9) as score from docs where match(body) against('alpha beta gamma delta') order by id;
select id, round(match(body) against('missing'), 9) as score from docs where match(body) against('missing') order by id;
select id, round(match(body) against('alpha alpha beta'), 9) as score from docs where match(body) against('alpha alpha beta') order by id;
select id, round(match(body) against('+alpha -beta' in boolean mode), 9) as score
 from docs where match(body) against('+alpha -beta' in boolean mode) order by id;
select id from docs where match(body) against('alpha beta gamma') > 0.5 order by id;
select id from docs where match(body) against('alpha beta gamma') order by id limit 2 offset 2;
prepare p from 'select id, round(match(body) against(?), 9) as score from docs where match(body) against(?) order by id';
set @q='alpha beta';
execute p using @q,@q;
set @q='gamma';
execute p using @q,@q;
set @q='missing';
execute p using @q,@q;
set @q='alpha beta';
execute p using @q,@q;
deallocate prepare p;
start transaction;
update docs set body='gamma' where id in (1,2);
select id, round(match(body) against('alpha beta gamma'),9) from docs where match(body) against('alpha beta gamma') order by id;
rollback;
select id, round(match(body) against('alpha beta gamma'),9) from docs where match(body) against('alpha beta gamma') order by id;
drop database fts_collector_state;
