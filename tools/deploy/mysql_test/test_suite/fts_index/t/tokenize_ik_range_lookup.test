# Range starts, ends and gaps; golden captured on 45831f2 before this change.
--disable_warnings
drop database if exists tokenize_ik_range_lookup;
--enable_warnings
create database tokenize_ik_range_lookup;
use tokenize_ik_range_lookup;
create table docs(id int primary key, body text);
insert into docs values (1,convert(X'e4b880e4b880e58897e4b8be' using utf8mb4));
insert into docs values (2,convert(X'e58d95e9bdbfe9a29de5ae9ae58d87e9998de883bde58a9b' using utf8mb4));
insert into docs values (3,convert(X'e58d96e4b88de587bae58ebb' using utf8mb4));
