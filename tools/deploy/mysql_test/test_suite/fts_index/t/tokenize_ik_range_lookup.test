insert into docs values (17,convert(X'efbca1efbca2efbca3efbc91efbc92efbc9320636166c3a920ed959ceab5adec96b4e6bca2e5ad97' using utf8mb4));
select id, tokenize(body collate utf8mb4_bin, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') as tokens from docs order by id;
select id, tokenize(body collate utf8mb4_bin, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') as tokens from docs order by id;
select id, tokenize(body collate utf8mb4_general_ci, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') as tokens from docs order by id;
select id, tokenize(body collate utf8mb4_general_ci, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') as tokens from docs order by id;
select id, tokenize(body collate utf8mb4_unicode_ci, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') as tokens from docs order by id;
select id, tokenize(body collate utf8mb4_unicode_ci, 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') as tokens from docs order by id;
alter table docs add fulltext index ft(body) with parser ik;
select id from docs where match(body) against('一一列举 醋劲 醉鬼') order by id;
begin;
update docs set body='数据库性能全文索引' where id between 1 and 6;
select count(*) from docs where match(body) against('数据库');
rollback;
select id from docs where match(body) against('一一列举 醋劲 醉鬼') order by id;
drop database tokenize_ik_range_lookup;
