# Boolean-only MATCH may omit scoring; score consumers retain BM25 semantics.
--disable_warnings
drop database if exists fts_filter_relevance;
--enable_warnings
create database fts_filter_relevance;
use fts_filter_relevance;
create table docs (id int primary key, body text,
  fulltext index ft_body(body) with parser beng);
insert into docs values
  (1, 'database database performance'),
  (2, 'database audit'),
  (3, 'performance audit audit'),
  (4, 'unrelated document'), (5, null), (6, ''), (7, 'the and');
select count(*) as hits from docs where match(body) against('database performance');
select count(*) as hits from docs where match(body) against('database performance') > 0;
select count(*) as hits from docs where 0 < match(body) against('database performance');
select count(*) as hits from docs where match(body) against('database performance') > 2;
select count(*) as hits from docs where not match(body) against('database performance');
select count(*) as hits from docs where match(body) against('database performance') or id = 4;
select count(*) as hits from docs where match(body) against('missing');
# Candidate lookup must retain its numeric relevance contract.
select count(*) as hits from docs force index(primary) where match(body) against('database performance');
select id, round(match(body) against('database performance'), 8) as score
  from docs where match(body) against('database performance') order by id;
select round(sum(match(body) against('database performance')), 8) as score_sum
  from docs where match(body) against('database performance');
# Both explicit and implicit score ordering, including LIMIT, must retain scoring.
select id from docs where match(body) against('database performance');
select id from docs where match(body) against('database performance') limit 2;
select id from docs where match(body) against('database performance')
  order by match(body) against('database performance') desc, id limit 2;
select id from docs where match(body) against('database performance') order by id limit 2;
# Changing a cached parameter from zero to a nonzero threshold must replan safely.
prepare filtered from 'select count(*) as hits from docs where match(body) against(?) > ?';
set @query = 'database performance';
set @threshold = 0;
execute filtered using @query, @threshold;
set @threshold = 2;
execute filtered using @query, @threshold;
set @threshold = 0;
execute filtered using @query, @threshold;
deallocate prepare filtered;
# Boolean search retains weighted scoring and its own membership rules.
select count(*) as hits from docs where match(body) against('+database -audit' in boolean mode);
# More than 256 query terms exercises the TAAT spill/hash path.
