--enable_query_log
select count(*), sum(id) from docs where match(body) against('alpha');
select count(*), sum(id) from docs where match(body) against('beta gamma');
select count(*), sum(id) from docs where match(body) against('alpha beta gamma');
select count(*), sum(id) from docs where match(body) against('missing');
select count(*), sum(id) from docs where match(body) against('alpha beta gamma delta epsilon zeta theta kappa omega');
select count(*), sum(id) from docs where match(body) against('+alpha +beta -gamma' in boolean mode);
select count(*), sum(id) from docs where match(body) against('alpha beta gamma') > 0.01;
select round(sum(match(body) against('alpha beta gamma')), 7) as score_sum from docs where match(body) against('alpha beta gamma');
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 254;
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 255;
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 256;
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 511;
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 1023;
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 1025;
prepare p from 'select count(*), sum(id) from docs where match(body) against(?)';
set @q='beta';
execute p using @q;
set @q='delta gamma';
execute p using @q;
set @q='missing';
execute p using @q;
deallocate prepare p;
start transaction;
update docs set body='omega' where id between 250 and 270;
select count(*), sum(id) from docs where match(body) against('beta gamma');
rollback;
select count(*), sum(id) from docs where match(body) against('beta gamma');
drop database fts_posting_refill;
