--enable_query_log
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 0 offset 0) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 1 offset 0) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 20 offset 0) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 20 offset 7) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 256 offset 255) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 2000 offset 0) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 20 offset 1090) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 20 offset 2000) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 20 offset 1080) v;
select count(*) as n from (select id from docs where match(body) against('alpha beta') and id<=21 limit 20 offset 7) v;
select count(*) from (select 1 from docs where match(body) against('alpha beta') limit 20) v;
select count(*),count(x) from (select NULL as x from docs where match(body) against('alpha beta') limit 20) v;
select count(*) from (select id from docs where match(body) against('missing') limit 20) v;
select count(*) from (select id from docs where match(body) against('alpha beta') > 0.5 limit 20) v;
select count(*) from (select id from docs where match(body) against('alpha beta') > 0.5 limit 2000) v;
select count(*) from (select id from docs where 0.5 < match(body) against('alpha beta') limit 2000) v;
select count(*) from (select id from docs where match(body) against('alpha beta') < 0.5 limit 2000) v;
select count(*) from (select 1 from docs order by match(body) against('alpha beta') desc limit 20) v;
select count(*) from (select id from docs where match(body) against('+alpha -gamma' in boolean mode) limit 20) v;
select count(*) from (select match(body) against('alpha beta') as score from docs where match(body) against('alpha beta') limit 20) v;
select count(*) from (select id from docs where match(body) against('alpha beta') order by id desc limit 20 offset 7) v;
select count(*) from (select 1 from (select id from docs where match(body) against('alpha beta') limit 40) x limit 20 offset 10) v;
select sum(id) from (select id from docs where match(body) against('alpha beta') order by match(body) against('alpha beta') desc,id limit 20) v;
select round(sum(score),8) from (select match(body) against('alpha beta') as score from docs where match(body) against('alpha beta') order by score desc,id limit 20) v;
select id,round(match(body) against('alpha beta'),8) as score from docs where match(body) against('alpha beta') order by score desc,id limit 5;
select count(*) from (select distinct id%3 from docs where match(body) against('alpha beta') limit 2) v;
select count(*) from (select 1 from docs where match(body) against('alpha beta') group by id%3 order by sum(id) limit 2) v;
select sum(rn) from (select row_number() over(order by id) as rn from docs where match(body) against('alpha beta') order by id limit 20) v;
select count(*) from (select /*+ no_rewrite */ 1 from docs where match(body) against('alpha beta') limit 20) v;
set @seen=0;
select count(*) from (select id from docs where match(body) against('alpha beta') order by (@seen:=@seen+1) limit 20) v;
select @seen > 20 as assignment_evaluated;
--error ER_SUBQUERY_NO_1_ROW
select count(*) from (select 1 from docs where match(body) against('alpha beta') order by (select id from docs where id<3) limit 20) v;
prepare p from 'select count(*) from (select id from docs where match(body) against(?) limit ? offset ?) v';
set @q='alpha beta',@n=20,@o=0;
execute p using @q,@n,@o;
set @n=0;
execute p using @q,@n,@o;
set @n=2000;
execute p using @q,@n,@o;
set @n=20,@o=2000;
execute p using @q,@n,@o;
deallocate prepare p;
drop database fts_project_pruning;
