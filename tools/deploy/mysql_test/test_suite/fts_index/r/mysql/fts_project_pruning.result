drop database if exists fts_project_pruning;
create database fts_project_pruning;
use fts_project_pruning;
create table docs(id int primary key, body text, fulltext index ft(body) with parser beng);
select count(*) as n from (select id from docs where match(body) against('alpha beta') limit 0 offset 0) v;
n
0
