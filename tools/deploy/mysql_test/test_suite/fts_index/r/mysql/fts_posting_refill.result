select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 1023;
id
1024
1025
select id from docs where match(body) against('alpha beta gamma') order by id limit 3 offset 1025;
id
prepare p from 'select count(*), sum(id) from docs where match(body) against(?)';
set @q='beta';
execute p using @q;
count(*)	sum(id)
257	33153
set @q='delta gamma';
execute p using @q;
count(*)	sum(id)
558	362258
set @q='missing';
execute p using @q;
count(*)	sum(id)
0	NULL
deallocate prepare p;
start transaction;
update docs set body='omega' where id between 250 and 270;
select count(*), sum(id) from docs where match(body) against('beta gamma');
count(*)	sum(id)
500	193773
rollback;
select count(*), sum(id) from docs where match(body) against('beta gamma');
count(*)	sum(id)
513	197121
drop database fts_posting_refill;
