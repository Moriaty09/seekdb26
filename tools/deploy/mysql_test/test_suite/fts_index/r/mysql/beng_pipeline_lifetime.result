set @tokens=tokenize(concat(@doc,' ',lower(@doc)), 'beng', '[{"output":"all"}]');
select json_length(json_extract(@tokens,'$.tokens')) as distinct_terms, json_extract(@tokens,'$.doc_len') as doc_len, md5(@tokens) as token_digest;
