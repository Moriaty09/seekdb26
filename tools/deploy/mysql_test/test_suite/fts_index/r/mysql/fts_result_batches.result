drop database if exists fts_result_batches;
create database fts_result_batches;
use fts_result_batches;
create table docs(id int primary key, body text, fulltext index ft(body) with parser beng);
select count(*), sum(id), min(id), max(id) from docs where match(body) against('database');
count(*)	sum(id)	min(id)	max(id)
1033	534061	1	1033
select count(*), sum(id) from docs where match(body) against('database') > 0.01;
count(*)	sum(id)
1033	534061
select count(*), sum(score > 0) from (select match(body) against('database') as score from docs where match(body) against('database')) t;
count(*)	sum(score > 0)
1033	1033
select count(*), sum(id), min(id), max(id) from docs where match(body) against('database performance');
count(*)	sum(id)	min(id)	max(id)
1033	534061	1	1033
select count(*), sum(id) from docs where match(body) against('database performance') > 0.01;
count(*)	sum(id)
1033	534061
select count(*), sum(score > 0) from (select match(body) against('database performance') as score from docs where match(body) against('database performance')) t;
count(*)	sum(score > 0)
1033	1033
select count(*), sum(id), min(id), max(id) from docs where match(body) against('+database -audit' in boolean mode);
count(*)	sum(id)	min(id)	max(id)
689	356041	1	1033
select count(*), sum(id) from docs where match(body) against('+database -audit' in boolean mode) > 0.01;
count(*)	sum(id)
689	356041
select count(*), sum(score > 0) from (select match(body) against('+database -audit' in boolean mode) as score from docs where match(body) against('+database -audit' in boolean mode)) t;
count(*)	sum(score > 0)
689	689
