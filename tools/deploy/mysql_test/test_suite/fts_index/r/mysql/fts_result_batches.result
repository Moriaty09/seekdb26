select count(*), sum(id) from docs where match(body) against('database performance audit absent');
count(*)	sum(id)
1033	534061
select count(*), sum(id) from docs where match(body) against('database performance') > 1e9;
count(*)	sum(id)
0	NULL
prepare p from 'select count(*), sum(id) from docs where match(body) against(?)';
set @q='performance';
execute p using @q;
count(*)	sum(id)
689	356041
set @q='audit';
execute p using @q;
count(*)	sum(id)
344	178020
deallocate prepare p;
drop database fts_result_batches;
