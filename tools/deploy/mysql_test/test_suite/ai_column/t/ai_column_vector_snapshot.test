# Extend upstream 47fa38c old-read-view coverage to AI result publication.
connection default;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py start 19128
--disable_warnings
drop database if exists ai_column_vector_snapshot;
--enable_warnings
create database ai_column_vector_snapshot;
use ai_column_vector_snapshot;
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_snapshot_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_snapshot');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('vector_snapshot',
  '{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('vector_snapshot_ep',
  '{"ai_model_name":"vector_snapshot","url":"http://127.0.0.1:19128/v1/embeddings","access_key":"vector-regeneration","provider":"openai","request_model_name":"mock-embed"}');
create table docs(id bigint primary key, content varchar(200),
  emb vector(4) AI COLUMN (AI_EMBED('vector_snapshot', content))
  WITH (sync_mode='async', max_retries=2));
create vector index vi on docs(emb)
  with(distance=l2, type=hnsw, lib=vsag, m=10,
       ef_construction=12, ef_search=40);
insert into docs(id, content) values (1, 'vec-zero');
let $wait_condition = select count(*) = 1 from docs where emb = [0,0,0,0];
--source mysql_test/include/wait_condition.inc
connect (snapshot_reader,$OBMYSQL_MS0,root@sys,,ai_column_vector_snapshot,$OBMYSQL_PORT);
connection snapshot_reader;
set session transaction isolation level repeatable read;
set ob_trx_timeout=120000000;
start transaction;
select id,content,emb from docs;
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
connection default;
update docs set content='vec-ten' where id=1;
let $wait_condition = select count(*) = 1 from docs where emb = [10,0,0,0];
--source mysql_test/include/wait_condition.inc
call dbms_vector.refresh_index('vi','docs','emb',1,'FAST');
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
connection snapshot_reader;
select id,content,emb from docs;
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
commit;
start transaction;
select id,content,emb from docs;
connection default;
delete from docs where id=1;
insert into docs(id,content) values (2,'vec-twenty');
let $wait_condition = select count(*) = 1 from docs where emb = [20,0,0,0];
--source mysql_test/include/wait_condition.inc
call dbms_vector.refresh_index('vi','docs','emb',1,'FAST');
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
connection snapshot_reader;
select id,content,emb from docs;
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
commit;
select id,content,emb from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10;
disconnect snapshot_reader;
connection default;
drop table docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_snapshot_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_snapshot');
drop database ai_column_vector_snapshot;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py stop 19128
