# Indexes created before any generated result must survive repeated publication.
connection default;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py start 19127
--disable_warnings
drop database if exists ai_column_vector_races;
--enable_warnings
create database ai_column_vector_races;
use ai_column_vector_races;
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_races_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_races');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('vector_races',
  '{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('vector_races_ep',
  '{"ai_model_name":"vector_races","url":"http://127.0.0.1:19127/v1/embeddings","access_key":"vector-regeneration","provider":"openai","request_model_name":"mock-embed"}');
create table docs(id bigint primary key, content varchar(200),
  emb vector(4) AI COLUMN (AI_EMBED('vector_races', content))
  WITH (sync_mode='async', max_retries=2));
create vector index vi on docs(emb)
  with(distance=l2, type=hnsw, lib=vsag, m=10,
       ef_construction=12, ef_search=40);
insert into docs(id, content) values (1, 'vec-zero'), (2, 'vec-ten');
--disable_query_log
let $rounds = 6;
while ($rounds)
{
  let $remaining = 150;
  let $ready = 0;
  while ($remaining)
  {
    let $ready = `select count(*) = 2 from docs where emb is not null`;
    if ($ready == 1)
    {
      let $remaining = 0;
    }
    if ($ready == 0)
    {
      --real_sleep 0.1
      dec $remaining;
    }
  }
  if ($ready != 1)
  {
    --die AI vectors did not reach READY
  }
  let $ok = `select count(*) = 2 and count(distinct id) = 2 from (select id from docs order by l2_distance(emb, [0,0,0,0]) approximate limit 10) ann`;
  if ($ok != 1)
  {
    --die AI vector publication lost or duplicated index entries
  }
  start transaction;
  update docs set content = concat(content, '-rollback');
  let $ok = `select count(*) = 0 from (select id from docs order by l2_distance(emb, [0,0,0,0]) approximate limit 10) ann`;
  if ($ok != 1)
  {
    --die AI vector invalidation left old entries visible
  }
  rollback;
  let $ok = `select count(*) = 2 from (select id from docs order by l2_distance(emb, [0,0,0,0]) approximate limit 10) ann`;
  if ($ok != 1)
  {
    --die AI vector rollback did not restore index visibility
  }
  dec $rounds;
  if ($rounds)
  {
    update docs set content = concat(content, '-next');
  }
}
--enable_query_log
select id, emb from docs order by id;
select count(*) = 1 and sum(id = 2) = 1 as regenerated_nearest_vector
from (select id from docs order by l2_distance(emb, [10,0,0,0]) approximate limit 1) ann;
update docs set content = 'slow-old vec-twenty' where id = 2;
let $remaining = 100;
let $claimed = 0;
while ($remaining)
{
  let $claimed = `select count(*) > 0 from oceanbase.__all_ai_column_task q join oceanbase.__all_table t on t.table_id=q.table_id join oceanbase.__all_database d on d.database_id=t.database_id where d.database_name='ai_column_vector_races' and q.state=1`;
  if ($claimed == 1) { let $remaining = 0; }
  if ($claimed == 0) { --real_sleep 0.01
    dec $remaining; }
}
eval select $claimed = 1 as old_request_in_flight;
update docs set content = 'vec-zero' where id = 2;
--real_sleep 2
select emb = [0,0,0,0] as late_vector_cannot_overwrite from docs where id = 2;
select count(*)=2 and sum(id=2)=1 as latest_ann_has_no_duplicate
from (select id from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10) ann;
update docs set content = 'slow-old vec-twenty' where id = 2;
let $remaining = 100;
let $claimed = 0;
while ($remaining)
{
  let $claimed = `select count(*) > 0 from oceanbase.__all_ai_column_task q join oceanbase.__all_table t on t.table_id=q.table_id join oceanbase.__all_database d on d.database_id=t.database_id where d.database_name='ai_column_vector_races' and q.state=1`;
  if ($claimed == 1) { let $remaining = 0; }
  if ($claimed == 0) { --real_sleep 0.01
    dec $remaining; }
}
eval select $claimed = 1 as deleted_request_in_flight;
delete from docs where id = 2;
insert into docs(id,content) values(2,'vec-ten');
--real_sleep 2
select emb = [10,0,0,0] as reinserted_key_keeps_new_vector from docs where id = 2;
select count(*)=1 and sum(id=2)=1 as reinserted_nearest_vector
from (select id from docs order by l2_distance(emb,[10,0,0,0]) approximate limit 1) ann;
update docs set content='slow-old vec-twenty' where id=2;
update docs set id=3 where id=2;
--real_sleep 2
select count(*)=1 and sum(id=3)=1 as moved_vector_visible
from (select id from docs order by l2_distance(emb,[20,0,0,0]) approximate limit 1) ann;
select count(*)=0 as moved_old_key_absent from docs where id=2;
# A dimension mismatch must reach FAILED without leaving a searchable vector.
update docs set content='wrong-vector-dimension' where id=3;
--real_sleep 3
select emb is null as failed_embedding_is_null from docs where id=3;
select count(*)=1 and sum(id=1)=1 as failed_embedding_absent_from_ann
from (select id from docs order by l2_distance(emb,[0,0,0,0]) approximate limit 10) ann;
set ai_column_strict_read=on;
--replace_regex /table_id=[0-9]+, column_id=[0-9]+/table_id=<table_id>, column_id=<column_id>/
--error 11120
select emb from docs;
set ai_column_strict_read=off;
select count(*)=1 as dimension_failure_archived from oceanbase.__all_ai_column_task_history q
join oceanbase.__all_table t on t.table_id=q.table_id
join oceanbase.__all_database d on d.database_id=t.database_id
where d.database_name='ai_column_vector_races' and q.state=3;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py assert 19127 vector-dimension-retries
select count(*)=0 as failed_vector_tasks_cleaned from oceanbase.__all_ai_column_task q
join oceanbase.__all_table t on t.table_id=q.table_id
join oceanbase.__all_database d on d.database_id=t.database_id
where d.database_name='ai_column_vector_races';
update docs set content='vec-ten' where id=3;
--real_sleep 1
select emb=[10,0,0,0] as embedding_recovers_after_failure from docs where id=3;
select count(*)=1 and sum(id=3)=1 as recovered_nearest_vector
from (select id from docs order by l2_distance(emb,[10,0,0,0]) approximate limit 1) ann;
drop table docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_races_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_races');
drop database ai_column_vector_races;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py stop 19127
