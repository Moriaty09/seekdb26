drop database if exists ai_column_vector_regeneration;
create database ai_column_vector_regeneration;
use ai_column_vector_regeneration;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_regeneration_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_regeneration');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('vector_regeneration',
'{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('vector_regeneration_ep',
'{"ai_model_name":"vector_regeneration","url":"http://127.0.0.1:19125/v1/embeddings","access_key":"vector-regeneration","provider":"openai","request_model_name":"mock-embed"}');
create table docs(id bigint primary key, content varchar(200),
emb vector(4) AI COLUMN (AI_EMBED('vector_regeneration', content))
WITH (sync_mode='async', max_retries=2));
create vector index vi on docs(emb)
with(distance=l2, type=hnsw, lib=vsag, m=10,
ef_construction=12, ef_search=40);
insert into docs(id, content) values (1, 'vec-zero'), (2, 'vec-ten');
select id, emb from docs order by id;
id	emb
1	[0,0,0,0]
2	[10,0,0,0]
select count(*) = 1 and sum(id = 2) = 1 as regenerated_nearest_vector
from (select id from docs order by l2_distance(emb, [10,0,0,0]) approximate limit 1) ann;
regenerated_nearest_vector
1
drop table docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('vector_regeneration_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('vector_regeneration');
drop database ai_column_vector_regeneration;
